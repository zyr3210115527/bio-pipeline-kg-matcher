# Copy this file to .env.local and fill in rotated local credentials.
LLM_API_KEY=replace-with-rotated-key
LLM_BASE_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=180
LLM_REQUIRED=0
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=16000

# Point these at the data provider's ("师姐") Neo4j backend.
# Local instance example (bundled/testing):
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
NEO4J_DATABASE=neo4j
# Remote server example (uncomment and fill in once she publishes it):
# NEO4J_URI=bolt://<server-host>:7687
# NEO4J_PASSWORD=<server-password>
NEO4J_CONNECT_TIMEOUT=2
NEO4J_QUERY_TIMEOUT=2
NEO4J_HEALTH_CACHE_TTL=30

# Delivery MCP uses the restored unified graph and fails closed in Neo4j mode.
DATA_MATCHER_MODE=neo4j
# auto: detect managed-v1 (lowercase datagraph_managed) vs legacy update728
# (Project/Study/... in either UPPER or lower case) automatically. Leave as auto
# so the same package reads her import regardless of label casing.
DATAGRAPH_SCHEMA_MODE=auto
# Only consulted in managed-v1 mode; ignored for the legacy update728 backend.
# The 0811 backend carries no managed snapshot, so leave this empty. Only set it
# when connecting to an older managed-v1 (datagraph_managed) import.
DATAGRAPH_SNAPSHOT_ID=
